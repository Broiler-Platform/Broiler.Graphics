<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Core is platform-neutral, fully safe, trimming/AOT friendly. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Broiler.Graphics</RootNamespace>
    <AssemblyName>Broiler.Graphics</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test runner reaches selected internals for core graphics coverage. -->
    <InternalsVisibleTo Include="Broiler.Graphics.Tests" />
    <!--
      The raster thread budget (BRasterParallelism) is internal, and the multithreading roadmap
      requires item #3 to be measured before it is believed. The benchmark runner sets that budget
      per run, so it needs the same access the test runner has. Broiler.HTML grants its own
      rasterizer's copy to the same assembly, for the same reason.
    -->
    <InternalsVisibleTo Include="Broiler.Render.Stage.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <!-- Graphics depends only on the media image ABSTRACTION. Concrete codecs
         (Broiler.Media.Image.Managed) are supplied by the application composition
         root via BImageCodecs.Use(...); see Imaging/BImageCodecs.cs. -->
    <ProjectReference Include="..\..\Broiler.Media\Broiler.Media.Image\Broiler.Media.Image.csproj" />
  </ItemGroup>

</Project>
