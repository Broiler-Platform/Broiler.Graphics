<Project>

  <!-- Broiler NuGet packaging metadata (vendored; do not edit by hand). -->
  <Import Project="$(MSBuildThisFileDirectory)eng\Broiler.Packaging.props" />

  <!-- Repository-owned packaging overrides. -->
  <PropertyGroup>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PackageProjectUrl>https://github.com/Broiler-Platform/Broiler.Graphics</PackageProjectUrl>
  </PropertyGroup>

</Project>
