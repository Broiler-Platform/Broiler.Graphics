<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>Broiler.Graphics.Android</RootNamespace>
    <AssemblyName>Broiler.Graphics.Android</AssemblyName>
    <PackageId>Broiler.Graphics.Android</PackageId>
    <Description>Android EGL / OpenGL ES presentation backend for Broiler.Graphics.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Linux;Release-Linux</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- The test runner reaches the internal geometry and pixel-conversion helpers. -->
    <InternalsVisibleTo Include="Broiler.Graphics.Android.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Graphics core only. The backend reaches Android through P/Invoke to libEGL, libGLESv3, and
         libandroid, so it needs no Mono.Android reference and builds without the android workload. -->
    <ProjectReference Include="..\Broiler.Graphics\Broiler.Graphics.csproj" />
  </ItemGroup>

</Project>
