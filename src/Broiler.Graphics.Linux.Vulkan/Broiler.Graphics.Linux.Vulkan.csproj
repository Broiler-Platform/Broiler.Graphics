<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RootNamespace>Broiler.Graphics.Linux.Vulkan</RootNamespace>
    <AssemblyName>Broiler.Graphics.Linux.Vulkan</AssemblyName>
    <Description>Linux Vulkan presentation backend for Broiler.Graphics (preview: Vulkan 1.2 loader/device path with a CPU-present fallback).</Description>
    <PackageTags>broiler;graphics;rendering;linux;vulkan</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Linux;Release-Linux</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Graphics\Broiler.Graphics.csproj" />
    <ProjectReference Include="..\Broiler.Graphics.Linux\Broiler.Graphics.Linux.csproj" />
  </ItemGroup>

</Project>
