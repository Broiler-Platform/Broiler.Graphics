<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- No hand-written `unsafe` remains: COM vtable calls go through ComVtable
         (Marshal.GetDelegateForFunctionPointer with cached delegates). This flag stays on
         only because the [LibraryImport] source generator emits unsafe marshalling stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Broiler.Graphics.Windows</RootNamespace>
    <AssemblyName>Broiler.Graphics.Windows</AssemblyName>
    <Description>Windows Direct2D/DirectWrite backend for Broiler.Graphics, with window and input integration and an HWND-backed video presentation target.</Description>
    <PackageTags>broiler;graphics;rendering;windows;direct2d;directwrite</PackageTags>
  </PropertyGroup>

  <PropertyGroup>
    <Configurations>Debug;Release;Debug-Windows;Release-Windows</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- The backend test runner reaches a few internals (image store, BGRA conversion). -->
    <InternalsVisibleTo Include="Broiler.Graphics.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Media.Video" Version="0.1.0-preview.10" />
    <PackageReference Include="Broiler.Media.Video.Windows" Version="0.1.0-preview.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Broiler.Graphics\Broiler.Graphics.csproj" />
    <!-- Graphics.Windows owns the HWND-backed video presentation target (HwndVideoOutput),
         which implements Broiler.Media.Video.Windows' IHwndVideoOutput contract per the media
         roadmap §6.6/§7.5. It references only the Video ABSTRACTIONS, never a codec
         implementation — and the dependency runs this way only: Media references nothing
         here (Broiler.Media ADR 0006). -->
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(BroilerNativeRoot)/src/Broiler.Native.Windows/Broiler.Native.Windows.csproj" Condition="Exists('$(BroilerNativeRoot)/src/Broiler.Native.Windows/Broiler.Native.Windows.csproj')" />
    <PackageReference Include="Broiler.Native.Windows" Version="$(BroilerNativeVersion)" Condition="!Exists('$(BroilerNativeRoot)/src/Broiler.Native.Windows/Broiler.Native.Windows.csproj')" />
  </ItemGroup>
</Project>
