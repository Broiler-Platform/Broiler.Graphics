<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Core is platform-neutral, fully safe, trimming/AOT friendly. -->
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>CS0618</WarningsNotAsErrors>
    <RootNamespace>Broiler.Graphics</RootNamespace>
    <AssemblyName>Broiler.Graphics</AssemblyName>
    <Description>Platform-neutral graphics core for Broiler: BBitmap, BCanvas, deterministic CPU rasterization, text and font handling, and the render-list pipeline.</Description>
    <PackageTags>broiler;graphics;rendering;raster;canvas</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- Backends share internal geometry, resource allocation, and CPU frame storage. -->
    <InternalsVisibleTo Include="Broiler.Graphics.Windows" />
    <InternalsVisibleTo Include="Broiler.Graphics.WebAssembly" />
    <InternalsVisibleTo Include="Broiler.Graphics.Android" />
    <InternalsVisibleTo Include="Broiler.Graphics.Linux.OpenGL" />
    <InternalsVisibleTo Include="Broiler.Graphics.Linux.Vulkan" />
    <!-- The test runner reaches selected internals for core graphics coverage. -->
    <InternalsVisibleTo Include="Broiler.Graphics.Tests" />
    <!--
      The raster thread budget (BRasterParallelism) is internal, and the multithreading roadmap
      requires item #3 to be measured before it is believed. The benchmark runner sets that budget
      per run, so it needs the same access the test runner has. Broiler.HTML grants its own
      rasterizer's copy to the same assembly, for the same reason.
    -->
    <InternalsVisibleTo Include="Broiler.Render.Stage.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Media.Image" Version="0.1.0-preview.11" />
  </ItemGroup>

</Project>
