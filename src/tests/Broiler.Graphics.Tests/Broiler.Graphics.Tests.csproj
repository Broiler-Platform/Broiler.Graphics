<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Graphics.Tests</RootNamespace>
    <AssemblyName>Broiler.Graphics.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Media.Image.Managed" Version="0.1.0-preview.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests depend on the platform-neutral Core, and — acting as the composition
         root — on the concrete managed codecs to register via BImageCodecs.Use(...). -->
    <ProjectReference Include="..\..\Broiler.Graphics\Broiler.Graphics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/CpuPresentationTests.cs" Link="CpuPresentationTests.cs" />
  </ItemGroup>
</Project>
