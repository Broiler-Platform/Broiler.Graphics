<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Broiler.Graphics.Windows.Tests</RootNamespace>
    <AssemblyName>Broiler.Graphics.Windows.Tests</AssemblyName>
    <!-- The runner is the process executable under `dotnet run`, so an icon here is what
         WindowIconTests expects every Direct2DWindow's class to pick up. -->
    <ApplicationIcon>TestApplicationIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Broiler.Media.Image.Managed" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Broiler.Graphics.Windows\Broiler.Graphics.Direct2D.csproj" />
    <!-- Composition root: supplies the concrete image codecs to Broiler.Graphics via BImageCodecs.Use(...). -->
  </ItemGroup>

</Project>
